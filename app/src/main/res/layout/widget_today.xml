<?xml version="1.0" encoding="utf-8"?>
<!-- 小部件布局（背景与文字随系统深浅色自动切换）：
     浅色：背景 #FCFDFF（课表白）/ 深色文字；深色：背景 #10151B（课表黑）/ 浅色文字。
     资源限定：drawable(-night)/widget_background.xml + values(-night)/colors.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- 标题行：今日课程（粗体 11sp）+ 日期 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GZMTU View"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_title"
            tools:text="今日课程" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary"
            tools:text="8月13日 周四" />
    </LinearLayout>

    <!-- 空状态提示 -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary"
        android:visibility="gone"
        tools:text="今日无课，好好休息"
        tools:visibility="visible" />

    <!-- 课程 1：彩色竖线 + 3 行文本 -->
    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_bar_1"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:text=""
            android:background="@drawable/widget_bar_00" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_body"
                tools:text="高等数学" />

            <TextView
                android:id="@+id/widget_location_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                tools:text="A栋201" />

            <TextView
                android:id="@+id/widget_time_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                tools:text="08:10 - 09:50" />
        </LinearLayout>
    </LinearLayout>

    <!-- 课程 2 -->
    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_bar_2"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:text=""
            android:background="@drawable/widget_bar_00" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_body" />

            <TextView
                android:id="@+id/widget_location_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary" />

            <TextView
                android:id="@+id/widget_time_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
